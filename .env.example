# Copy to .env (the setup wizard does this). Never commit .env.

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (16 letters; spaces are fine)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Official address that outgoing mail is SENT from (optional; defaults to GMAIL_ADDRESS).
# If it's a college/Workspace account that blocks App Passwords, leave the password empty,
# set gmail.official_auth: oauth in config.yaml and run `python -m nova login-mail`.
OFFICIAL_MAIL_ADDRESS=
OFFICIAL_MAIL_APP_PASSWORD=

# Discord bot token from https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Shared secret between Nova and the local WhatsApp bridge. Any random string.
WA_BRIDGE_TOKEN=change-me-to-something-random

# PIN for the phone app (Tailscale). Remote access stays off until this is set.
NOVA_PIN=

# Optional: override the dashboard URL from config.yaml
# DASHBOARD_URL=

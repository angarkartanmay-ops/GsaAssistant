# Copy to .env (the setup wizard does this). Never commit .env.

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (16 letters; spaces are fine)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Discord bot token from https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Shared secret between Malice and the local WhatsApp bridge. Any random string.
WA_BRIDGE_TOKEN=change-me-to-something-random

# Optional: override the dashboard URL from config.yaml
# DASHBOARD_URL=
